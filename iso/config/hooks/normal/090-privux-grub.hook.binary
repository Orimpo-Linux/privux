#!/bin/sh
set -eu
# live-build binary hook: brand the generated GRUB menu in the ISO tree.
if [ ! -s binary/boot/grub/privux-boot.png ] && [ -s config/includes.binary/boot/grub/privux-boot.png ]; then
  install -d binary/boot/grub
  cp config/includes.binary/boot/grub/privux-boot.png binary/boot/grub/privux-boot.png
fi
if [ ! -s binary/boot/grub/privux-boot.png ]; then
  echo "WARNING: Privux GRUB artwork missing; retaining stock GRUB rather than failing ISO" >&2
  exit 0
fi
for cfg in binary/boot/grub/grub.cfg binary/EFI/boot/grub.cfg; do
  [ -f "$cfg" ] || continue
  sed -i 's/Debian GNU\/Linux/Privux Linux/g; s/Debian Live/Privux Linux/g; s/Debian/Privux/g' "$cfg"
  tmp="$(mktemp)"
  cat > "$tmp" <<'EOF'
insmod all_video
insmod png
if [ -f /boot/grub/privux-boot.png ]; then
    background_image /boot/grub/privux-boot.png
    set color_normal=white/black
    set color_highlight=cyan/black
fi
EOF
  cat "$cfg" >> "$tmp"
  cat "$tmp" > "$cfg"
  rm -f "$tmp"
done
